# Sao chép tệp này thành .env trước khi chạy: cp .env.example .env
# KHÔNG commit tệp .env thật vào Git. Đổi mọi giá trị khoá khi triển khai thật.

# Chuỗi kết nối Kho dữ liệu (SQLite mặc định cho môi trường đóng gói độc lập)
DWH_URL=sqlite:///data/mekong_dw.db

# Thư mục chứa dữ liệu nguồn mẫu (5 tệp CSV của Mekong Mobile)
DATA_DIR=dataset

# Khoá bí mật dùng để giả danh hoá HMAC-SHA256 (bắt buộc >= 32 ký tự)
PSEUDO_KEY=mekong-mobile-hmac-secret-key-2026-min-32-bytes

# Cổng mở cho Dashboard BI / Healthcheck trên máy chủ
APP_PORT=8501
